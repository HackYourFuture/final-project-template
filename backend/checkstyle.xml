<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  A relaxed Checkstyle ruleset: catches likely bugs and bad practices
  without enforcing strict formatting (line length, indentation, javadoc, etc).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- Generous size limit, just to catch extreme cases -->
    <module name="LineLength">
        <property name="max" value="150"/>
    </module>

    <module name="TreeWalker">
        <!-- Likely bugs -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>
        <module name="CovariantEquals"/>
        <module name="EmptyCatchBlock"/>
        <module name="EmptyStatement"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="StringLiteralEquality"/>
        <module name="InnerAssignment"/>
        <module name="ModifiedControlVariable"/>
        <module name="NeedBraces"/>

        <!-- Unused / redundant code -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="UnusedLocalVariable"/>
        <module name="MultipleVariableDeclarations"/>

        <!-- Good OO / encapsulation habits -->
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
        </module>
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
            <property name="ignoreAbstractMethods" value="true"/>
        </module>

        <!-- Basic naming conventions -->
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>
        <module name="ParameterName"/>

        <!-- Spring Boot conventions -->
        <module name="IllegalImport">
            <property name="illegalClasses" value="org.springframework.beans.factory.annotation.Autowired"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Avoid System.out/err; use a SLF4J logger instead (e.g. Lombok's @Slf4j)."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
