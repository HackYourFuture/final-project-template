# Copy to .env and fill in. Never commit .env.
#
# Your team's Databricks catalog, secret scope and Airflow instance were
# created for you. A teacher gives you the values that are not listed here.

# --- Source API -------------------------------------------------------------
# The API your pipeline fetches from. Arbeitnow needs no key and is a good
# first target while you get the shape right. Replace it with your source.
SOURCE_API_URL=https://www.arbeitnow.com/api/job-board-api
SOURCE_NAME=postings

# --- Raw file storage -------------------------------------------------------
# Your ADLS account, created by infra/main.bicep. There is no key here on
# purpose: the code authenticates with your `az login` locally and with the
# Container Apps job's managed identity in Azure.
STORAGE_ACCOUNT=
STORAGE_CONTAINER=raw

# --- Databricks -------------------------------------------------------------
# CATALOG is your team's catalog: team_a, team_b or team_c. You have full
# rights inside it and no rights at all in the other two. dbt needs these;
# the ingestion job does not.
# Your team has its own Databricks identity. Read both values from Key Vault:
#   az keyvault secret show --vault-name kv-hyf-data \
#     --name fp-databricks-client-id-team-a --query value -o tsv
#   az keyvault secret show --vault-name kv-hyf-data \
#     --name fp-databricks-client-secret-team-a --query value -o tsv
DATABRICKS_HOST=https://adb-7405619530719547.7.azuredatabricks.net
# The shared SQL warehouse. Every team uses it, and Unity Catalog still keeps
# your data to yourselves: sharing compute is not sharing tables.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/a420c3e4cca59004
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=
DBT_SCHEMA=analytics

# --- Backend database -------------------------------------------------------
# The database the backend trainees read. Airflow publishes your mart into it.
# The defaults match the Postgres that docker compose starts, so you can build
# and test the sync before the real backend database exists.
BACKEND_PG_HOST=localhost
BACKEND_PG_PORT=5432
BACKEND_PG_DB=backend
BACKEND_PG_USER=postgres
BACKEND_PG_PASSWORD=postgres
BACKEND_PG_SCHEMA=public
