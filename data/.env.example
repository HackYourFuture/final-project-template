# Copy to .env and fill in. Never commit .env.
#
# Two values are yours alone and marked "your teacher gives you this". The rest
# is the same for every team and already filled in. There is no credential to
# fetch: everything here signs you in as yourself.
#
# Your Airflow instance already has these as Airflow Variables, set when your
# team was provisioned. This file is for running things on your own machine.

# --- Source API -------------------------------------------------------------
# The API your pipeline fetches from. Arbeitnow needs no key and is a good
# first target while you get the shape right. Replace it with your source.
SOURCE_API_URL=https://www.arbeitnow.com/api/job-board-api
# Names the folder your files land in, so two sources never overwrite each
# other. Lowercase, no spaces.
SOURCE_NAME=postings

# Where your own runs write. Two containers, and the split is enforced: the
# scheduled pipeline writes `landing`, which you can only read, and you write
# `dev`, which only you and your teammates can write. Put your name in the
# prefix so two of you never overwrite each other.
LANDING_CONTAINER=dev
LANDING_PREFIX=your-name

# --- Landing zone -----------------------------------------------------------
# Your team's storage account. The ingestion job writes raw files into its
# `landing` container, and Unity Catalog shows the same files at
# /Volumes/<catalog>/landing/raw, so dbt reads them without knowing they are
# blobs. Your own runs write the `dev` container, which appears alongside it
# at /Volumes/<catalog>/landing/dev.
#
# There is no key and no connection string. The job authenticates as itself:
# your `az login` locally, its managed identity in Azure. If you are asked for
# a connection string somewhere, you are on the wrong path.
STORAGE_ACCOUNT=                      # your teacher gives you this

# --- Databricks -------------------------------------------------------------
# Your team's catalog, and none of the other teams'. Inside it you can make
# and own your own dev_ schemas, and read the ones the scheduled run
# publishes. dbt builds here; the ingestion job only names it in a log line.
DATABRICKS_CATALOG=                   # your teacher gives you this
# The SQL warehouse, shared by all three teams and sized 2X-Small. Sharing the
# compute changes nothing about who can see what: permissions live on the
# catalog, so your queries still reach your catalog and no one else's.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0aae52a375e34214
DATABRICKS_HOST=https://adb-7405619530719547.7.azuredatabricks.net

# The schema dbt builds into, and the one the enrichment writes back to. Give
# each teammate their own while you are developing, so two people running dbt
# do not overwrite each other. The scheduled run uses `analytics`.
DBT_SCHEMA=dev_yourname

# What dbt reads. Must match LANDING_PREFIX above, or you will build models
# from somebody else's files. `uv run python -m src.pipeline` prints the exact
# value to use as its last line.
LANDING_PATH=/Volumes/<your catalog>/landing/dev/your-name/postings

# Nothing else goes here. In particular there is no Databricks credential:
# leave these two out and every step signs you in as yourself, using the same
# `az login` the landing zone uses. dbt opens a browser once and caches the
# token; the enrichment and publish steps ask Azure for one directly.
#
# The team's service principal exists, in Key Vault, and Airflow uses it for
# the scheduled run. It is not yours to carry around: with it on your laptop,
# one wrong DBT_SCHEMA overwrites the models your team demo depends on.
#
#   DATABRICKS_CLIENT_ID=
#   DATABRICKS_CLIENT_SECRET=
#   AZURE_TENANT_ID=07a14c4e-d88c-42f7-83b3-13af7e57ff3d

# --- Backend database -------------------------------------------------------
# The database the backend trainees read. Your pipeline publishes marts into
# its `analytics` schema, and can read the backend's own tables in `public`.
# Neither side can write to the other's schema.
#
# The defaults match the Postgres that `docker compose up` starts at the repo
# root, so you can build and test the sync before the real database exists.
BACKEND_PG_HOST=localhost
BACKEND_PG_PORT=5432
BACKEND_PG_DB=mydb
BACKEND_PG_USER=admin
BACKEND_PG_PASSWORD=password
# Where you publish to. `analytics_dev` locally, `analytics` on the real
# database: the local Postgres ships with both.
BACKEND_PG_PUBLISH_SCHEMA=analytics_dev
# The local container has no TLS certificate; Azure requires one.
BACKEND_PG_SSLMODE=prefer
