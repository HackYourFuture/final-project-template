# Copy to .env and fill in. Never commit .env.
#
# **Walkthrough example: team-a.** Storage account, catalog, resource group, and
# registry below are prefilled for team-a (`sthyffpteama`, `team_a`,
# `rg-hyf-fp-team-a`, `acrhyffpa`). On team-b, team-c, or team-d, replace those
# four with your team's values — the pattern is always `sthyffpteam<x>`,
# `team_<x>`, `rg-hyf-fp-team-<x>`, `acrhyffp<x>`. Personal settings
# (`LANDING_PREFIX`, `DBT_SCHEMA`, `DATABRICKS_TOKEN`, Postgres password) are
# yours regardless of team.
#
# Your Airflow instance already has team settings as Airflow Variables. This
# file is for running things on your own machine.

# --- Source API -------------------------------------------------------------
# The API your pipeline fetches from. Arbeitnow needs no key and is a good
# first target while you get the shape right. Replace it with your source.
SOURCE_API_URL=https://www.arbeitnow.com/api/job-board-api
# Names the folder your files land in, so two sources never overwrite each
# other. Lowercase, no spaces.
SOURCE_NAME=postings

# Where your own runs write. Two containers, and the split is enforced: the
# scheduled pipeline writes `prod`, which you can only read, and you write
# `dev`, which only you and your teammates can write. Put your name in the
# prefix so two of you never overwrite each other.
LANDING_CONTAINER=dev
LANDING_PREFIX=your-name

# --- Landing zone -----------------------------------------------------------
# Team-a example below. Other teams: sthyffpteamb, sthyffpteamc, sthyffpteamd.
#
#   az storage account list -g rg-hyf-fp-team-a --query "[0].name" -o tsv
STORAGE_ACCOUNT=sthyffpteama

# --- Databricks -------------------------------------------------------------
# Team-a catalog below. Other teams: team_b, team_c, team_d.
DATABRICKS_CATALOG=team_a
# The SQL warehouse, shared by all teams and sized 2X-Small. Sharing the
# compute changes nothing about who can see what: permissions live on the
# catalog, so your queries still reach your catalog and no one else's.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0aae52a375e34214
DATABRICKS_HOST=https://adb-7405619530719547.7.azuredatabricks.net

# The schema dbt builds into, including the enrichment model. Give
# each teammate their own while you are developing, so two people running dbt
# do not overwrite each other. The scheduled run uses `analytics`.
DBT_SCHEMA=dev_yourname

# What dbt reads. Must match LANDING_PREFIX above, or you will build models
# from somebody else's files. `uv run python -m src.ingestion.pipeline` prints the exact
# value to use as its last line.
LANDING_PATH=/Volumes/team_a/landing/dev/your-name/postings

# Your own personal access token, exactly as in Week 13: your name in the top
# bar, Settings, Developer, Access tokens, Generate new token. dbt reads it,
# and so does the publish step, so one value covers everything
# you run locally.
#
# It is yours, not your team's. `select session_user()` will show your email,
# which is what makes the Databricks audit log worth reading. Treat it like a
# database password: it goes in .env and nowhere else, and it belongs in no
# Slack message and no LLM prompt.
DATABRICKS_TOKEN=

# The team's service principal is not here on purpose. It lives in Key Vault,
# Airflow uses it for the scheduled run, and it can write the schemas you
# cannot. Nothing you run on your machine needs it.

# --- Backend database -------------------------------------------------------
# You publish to the real database, not to a copy on your laptop. Connecting to
# the real one is what exercises TLS, the firewall and your grants, and those
# are exactly what breaks on a first scheduled run if nobody tried them.
#
# Three schemas, and which you may write is enforced by your role rather than
# by agreement:
#
#   analytics       the scheduled run writes it, you can read it
#   analytics_dev   you write it, the scheduled run cannot even read it
#   app             the backend writes it, you can read it
#
# Same table names in both analytics schemas, so promoting a mart changes where
# it lives and nothing the backend selects. You and your teammates share
# `analytics_dev`, so the last publish wins: the table carries a comment saying
# which schema it came from and when, which is how you tell whose run you are
# looking at.
#
# Fetch team-a secrets (team-b/c/d: replace `team-a` with your team letter):
#
#   az keyvault secret show --vault-name kv-hyf-data --name fp-pg-host-team-a --query value -o tsv
#   az keyvault secret show --vault-name kv-hyf-data --name fp-pg-port-team-a --query value -o tsv
#   az keyvault secret show --vault-name kv-hyf-data --name fp-pg-db-team-a --query value -o tsv
#   az keyvault secret show --vault-name kv-hyf-data --name fp-pg-analytics-dev-team-a --query value -o tsv
BACKEND_PG_HOST=                      # from Key Vault (see above)
BACKEND_PG_PORT=5432
BACKEND_PG_DB=project_db
# Not `analytics_user`. That role writes production and its password is
# readable only by your team's Airflow VM.
BACKEND_PG_USER=analytics_dev_user
BACKEND_PG_PASSWORD=                  # from Key Vault (see above)
BACKEND_PG_PUBLISH_SCHEMA=analytics_dev
# Azure requires TLS. Leave this alone unless you are pointing at a container
# on your own machine, which has no certificate.
BACKEND_PG_SSLMODE=require

# --- Running the whole DAG on your machine (optional) -----------------------
# Everything above is enough to run the three steps by hand. Set these as well
# and `astro dev start` in data/airflow runs the real DAG: it starts the same
# Container Apps job the scheduled run starts, then builds dbt and publishes,
# all from your machine.
#
# The dev job lands in the `dev` container. Your LANDING_PATH above must point
# at the prefix it writes, or dbt builds from a folder nothing wrote to.
ACA_INGEST_JOB=job-fp-ingest-dev
#
# Team-a example. Other teams: rg-hyf-fp-team-b, etc.
#   az containerapp job show -g rg-hyf-fp-team-a -n job-fp-ingest-dev \
#     --query id -o tsv
AZURE_SUBSCRIPTION=1120c89d-2a5f-4a15-a582-2ea34f0bb5c3
AZURE_RESOURCE_GROUP=rg-hyf-fp-team-a
#
# For Mode 2 docker push commands in docs/dev_flow.md:
#   az acr list -g rg-hyf-fp-team-a --query "[].{name:name,loginServer:loginServer}" -o tsv
ACR_NAME=acrhyffpa
AZURE_TENANT_ID=07a14c4e-d88c-42f7-83b3-13af7e57ff3d
#
# Laptop credential for starting the dev ACA job only (not the prod principal).
# Team-a example; other teams: fp-devrun-client-id-team-b, etc.
#   az keyvault secret show --vault-name kv-hyf-data \
#     --name fp-devrun-client-id-team-a --query value -o tsv
#   az keyvault secret show --vault-name kv-hyf-data \
#     --name fp-devrun-client-secret-team-a --query value -o tsv
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
