# Copy to .env before running `astro dev start`. Never commit .env.
#
# BACKEND_PG_HOST is the compose service name "backend-db", not localhost and
# not "postgres": Airflow ships its own service called postgres, and that name
# would resolve to Airflow's metadata database instead of the backend's. The
# Airflow containers join the "finalproject" network created by
# ../docker-compose.yml.
# Start the stand-in database first with:
#   (cd .. && docker compose up -d backend-db)

SOURCE_API_URL=https://www.arbeitnow.com/api/job-board-api

BACKEND_PG_HOST=backend-db
BACKEND_PG_PORT=5432
BACKEND_PG_DB=backend
BACKEND_PG_USER=postgres
BACKEND_PG_PASSWORD=postgres

DBT_SCHEMA=analytics
